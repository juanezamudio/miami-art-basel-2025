{
  "name": "basel-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit-data && next build --webpack",
    "generate:social-image": "node scripts/generate-social-image.mjs",
    "start": "next start",
    "lint": "eslint",
    "preprocess-data": "node --experimental-strip-types scripts/preprocess-csv.js",
    "update-data": "node --experimental-strip-types scripts/convert-csv.js",
    "geocode": "node scripts/geocode-events.js",
    "archive": "node --experimental-strip-types scripts/archive-events.js",
    "audit-data": "node --experimental-strip-types scripts/audit-events.js",
    "test": "node --experimental-strip-types --test tests/*.test.cjs",
    "typecheck": "next typegen && tsc --noEmit",
    "sources:check": "python3 scripts/monitor_event_sources.py",
    "test:sources": "python3 -m unittest discover -s tests -p 'test_source_monitor.py'"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@google/generative-ai": "^0.24.1",
    "@tanstack/react-query": "^5.90.11",
    "@vercel/analytics": "^1.5.0",
    "@web3modal/wagmi": "^5.1.11",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "^5.0.0",
    "viem": "^2.40.3",
    "wagmi": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "ignore-loader": "^0.1.2",
    "playwright": "1.58.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x"
  }
}
